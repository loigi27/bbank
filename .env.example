# BBank 2026 — variáveis opcionais

# Porta local do servidor
PORTA=8000

# Tempo de cache dos dados do Google Sheets.
# 3 = atualiza a cada 3 segundos; 0 = consulta em toda requisição.
CACHE_SEGUNDOS=3

# ID da planilha (se omitido, usa o ID configurado no código)
# GOOGLE_SHEET_ID=11jArIL27b7rhZSXWzfi4M7UPLaEGI8sraruHPQnfbSE

# Configuração SMTP para as aquisições.
# NÃO coloque uma senha real neste arquivo se ele for compartilhado.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=seu-email@example.com
# SMTP_PASSWORD=sua-senha-ou-app-password
# SMTP_FROM=seu-email@example.com
# ADMIN_EMAIL=destinatario@example.com
